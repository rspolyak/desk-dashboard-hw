	(text "1 = SPI boot, 0 = download (SW2 BOOT to GND)\nJTAG source select: left NC (default)\nVDD_SPI 3.3 V (internal pull-down): left NC\nROM log / boot mode (pull-down): left NC\nR5 10K + C6 1uF power-on delay; SW1 RESET"
		(at 121.92 156.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b38193f6-4648-49cb-99f9-3b7548f19b3b")
	)
	(text "MECHANICAL\nSmall PCB, held by the J2 socket alone (on the\ndisplay-facing side; all other parts outward).\n2x M3 holes on the edge opposite J2: optional\nscrews/standoffs (~11 mm) rest on the display PCB.\nUSB-C on an edge; antenna end kept clear."
		(at 113.03 169.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ec2efe55-e0ca-4d04-ac8d-8f22c1dbac10")
	)
