  (pad "2" smd rect (at 0.75 0) (size 0.8 0.8) (layers "F.Cu" "F.Paste" "F.Mask")  )
  (fp_rect (start -1.3000 -0.5500) (end 1.3000 0.5500) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_rect (start -1.3000 -0.5500) (end 1.3000 0.5500) (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_poly (pts (xy -0.8500 -0.1000) (xy -0.5500 -0.4000) (xy 0.8500 -0.4000) (xy 0.8500 0.4000) (xy -0.8500 0.4000)) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_circle (center -1.7000 0.0000) (end -1.5500 0.0000) (stroke (width 0.1) (type solid)) (fill solid) (layer "F.SilkS"))
  (fp_text reference "REF**" (at 0.0000 -1.5500 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "Everlight_ALS-PT19" (at 0.0000 1.5500 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
